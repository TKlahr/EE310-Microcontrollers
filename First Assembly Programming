//-----------------------------
// Title: First Assembly Programming
//-----------------------------
// Purpose: This program compares an input temperature to a measured temperature and either turns on a cooling fan or heater to regulate temperature. 
// Dependencies: xc.inc
// Compiler: MPLAB X IDE v6.30
// Author: Tyler Klahr
// OUTPUTS: PORTD1 and PORTD2 are connected to the cooling fan and heater.
// INPUTS: The two inputs are the refference temperature and the measured temperature from the sensor. Connected to a decimal to hex converter.
// Versions:
//  	V1.0: 3/9/26 - First version 
//  	V1.1: 3/11/26 - Writing body of program
 
#include <xc.inc>

;-------------------------
; Reset Vector
;-------------------------
PSECT resetVec,class=CODE,reloc=2
resetVec:
    GOTO    start       ; jump to main program

;-------------------------
; Program Code
;-------------------------
PSECT code
ORG     0x20          ;Program starts at 0x20

start:

;----------------
; Program Inputs
;----------------
#define measuredTempInput  -5       ; test value for measured temperature
#define refTempInput       15       ; test value for referecence temperature

;-------------
; Definitions
;-------------
refTemp         EQU     0x20       ; register for referecence temperature
measuredTemp    EQU     0x21       ; register for measured temperature
contReg         EQU     0x22       ; control register

REG10           EQU     0x10       ; temporary register for referecence temperature conversion
REG11           EQU     0x11       ; temporary register for measured temperature conversion

refOnes         EQU     0x60       ; decimal storage registers
refTens         EQU     0x61
refHundreds     EQU     0x62

measOnes        EQU     0x70
measTens        EQU     0x71
measHundreds    EQU     0x72

;-------------------
; PORTD Bit Meanings
;-------------------
; PORTD.1 = HEATING
; PORTD.2 = COOLING

HEATER  EQU 1
COOLING EQU 2

;-------------------------
; Initialize PORTD
;-------------------------
    CLRF    TRISD       ; set PORTD pins as outputs
    CLRF    LATD        ; clear all outputs


;-------------------------
; Load input values
;-------------------------
    MOVLW   refTempInput
    MOVWF   refTemp       ; store reference temperature

    MOVLW   measuredTempInput
    MOVWF   measuredTemp       ; store measured temperature

;-------------------------
; Compare temperatures and control outputs
;-------------------------
    BTFSC   measuredTemp,7         ; check if measured temperature is negative
    BRA     MEAS_NEGATIVE
    BRA     MEAS_POSITIVE

MEAS_NEGATIVE:
    BTFSC   refTemp,7
    BRA     SAME_SIGN_COMPARE      ; check if both negative
    BRA     measuredTempLESS       ; measuredTemp negative, refTemp positive

MEAS_POSITIVE:
    BTFSC   refTemp,7
    BRA     measuredTempGREATER    ; measuredTemp positive, refTemp negative
    BRA     SAME_SIGN_COMPARE      

SAME_SIGN_COMPARE:
    MOVF    refTemp,W
    SUBWF   measuredTemp,W         ; W = measuredTemp - refTemp

    BZ      TEMPSEQUAL
    BC      measuredTempGREATER
    BRA     measuredTempLESS

TEMPSEQUAL:
    CLRF    contReg                ; contReg = 0
    BCF     LATD,HEATER            ; heating OFF
    BCF     LATD,COOLING           ; cooling OFF
    BRA     CONTINUE

measuredTempGREATER:
    MOVLW   0x02
    MOVWF   contReg                ; contReg = 2
    BCF     LATD,HEATER            ; heating OFF
    BSF     LATD,COOLING           ; cooling ON
    BRA     CONTINUE

measuredTempLESS:
    MOVLW   0x01
    MOVWF   contReg                ; contReg = 1
    BSF     LATD,HEATER            ; heating ON
    BCF     LATD,COOLING           ; cooling OFF

CONTINUE:

;-------------------------
; Decimal conversion for refTemp
;-------------------------
    CLRF refOnes
    CLRF refTens
    CLRF refHundreds

    MOVF refTemp,W
    MOVWF REG10

REF_HUNDREDS:
    MOVLW 100
    SUBWF REG10,F
    BNC REF_HUNDREDS_DONE
    INCF refHundreds,F
    BRA REF_HUNDREDS

REF_HUNDREDS_DONE:
    MOVLW 100
    ADDWF REG10,F

REF_TENS:
    MOVLW 10
    SUBWF REG10,F
    BNC REF_TENS_DONE
    INCF refTens,F
    BRA REF_TENS

REF_TENS_DONE:
    MOVLW 10
    ADDWF REG10,F

    MOVF REG10,W
    MOVWF refOnes

;-------------------------
; Decimal conversion for measuredTemp
;-------------------------
    CLRF measOnes
    CLRF measTens
    CLRF measHundreds

    MOVF measuredTemp,W
    MOVWF REG11

; Make measuredTemp positive if negative (2s comp)
    BTFSS REG11,7
    BRA MEAS_ABS_READY

    COMF REG11,F
    INCF REG11,F

MEAS_ABS_READY:

MEAS_HUNDREDS:
    MOVLW 100
    SUBWF REG11,F
    BNC MEAS_HUNDREDS_DONE
    INCF measHundreds,F
    BRA MEAS_HUNDREDS

MEAS_HUNDREDS_DONE:
    MOVLW 100
    ADDWF REG11,F

MEAS_TENS:
    MOVLW 10
    SUBWF REG11,F
    BNC MEAS_TENS_DONE
    INCF measTens,F
    BRA MEAS_TENS

MEAS_TENS_DONE:
    MOVLW 10
    ADDWF REG11,F

    MOVF REG11,W
    MOVWF measOnes

;-------------------------
; End program (infinite loop)
;-------------------------
ENDPROGRAM:
    BRA ENDPROGRAM

END
