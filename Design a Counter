;----------------------------------------------------
; Title: Hex Counter with 7-Segment Display
;----------------------------------------------------
; Purpose: This program uses two push buttons to control a hexadecimal counter displayed on a 7-segment display. One button increments the count, the other decrements it, and pressing both resets the count to zero.
; Dependencies: xc.inc
; Compiler: MPLAB X IDE v6.30 (XC8 Assembler)
; Author: Tyler Klahr
; Inputs: RB6 - Switch A (Increment), RB7 - Switch B (Decrement)
; Outputs: RD0–RD6 - 7-segment display (segments A–G)
; Versions: 
;     v1.0: 4/1/26 - Initial version
;----------------------------------------------------

       #include    <xc.inc>

;----------------------------------------------------
; Configuration Bits
;----------------------------------------------------
CONFIG FEXTOSC = OFF
CONFIG RSTOSC = HFINTOSC_1MHZ
CONFIG CLKOUTEN = OFF
CONFIG PR1WAY = ON
CONFIG CSWEN = ON
CONFIG FCMEN = OFF

;----------------------------------------------------
; Variables
;----------------------------------------------------
PSECT udata_acs
count: DS 1
temp: DS 1
temp2: DS 1

;----------------------------------------------------
; Reset Vector
;----------------------------------------------------
PSECT resetVec,class=CODE,reloc=2
resetVec:
        goto Start

;----------------------------------------------------
; Main Program
;----------------------------------------------------
PSECT code

Start:                     ; initialize ports
        banksel ANSELB
        clrf    ANSELB
        clrf    ANSELD

        banksel TRISB
        movlw   0xC0
        movwf   TRISB

        banksel TRISD
        clrf    TRISD

        banksel LATD
        clrf    LATD

        movlw   0x00              ; initialize counter
        movwf   count


;----------------------------------------------------
MainLoop:
call DisplayCount              ; display current count

        banksel PORTB              ; check buttons
        btfss   PORTB, 6
        goto    CheckBOnly
        btfss   PORTB, 7
        goto    CheckAOnly
        goto    ResetCount

;----------------------------------------------------
CheckAOnly:
btfss PORTB, 6              ; check increment button(RB6)
goto CheckBOnly

        movlw   0x0F
        cpfseq  count
        goto    IncCount
        goto    HoldLoop

IncCount:              ; increment count
incf count, f
call Delay
goto MainLoop

;----------------------------------------------------
CheckBOnly:
btfss PORTB, 7              ; check decrement button(RB7)
goto HoldLoop

        movf    count, w
        bz      HoldLoop
        decf    count, f
        call    Delay
        goto    MainLoop

;----------------------------------------------------
ResetCount:
        clrf    count              ; reset count to 0
        call    Delay
        goto    MainLoop

;----------------------------------------------------
HoldLoop:
        goto    MainLoop              ; nothing pressed, hold value

;----------------------------------------------------
; Display using POINTER (FSR0)
;----------------------------------------------------
DisplayCount:
        movf    count, w              ; convert count to 7-seg table
        call    SegTable
        lfsr    0, LATD
        movwf   INDF0
        return

;----------------------------------------------------
; 7-Segment Table
;----------------------------------------------------
SegTable:
        addwf   PCL, f              ; hex values 0-F
        retlw   0x3F    ; 0
        retlw   0x06    ; 1
        retlw   0x5B    ; 2
        retlw   0x4F    ; 3
        retlw   0x66    ; 4
        retlw   0x6D    ; 5
        retlw   0x7D    ; 6
        retlw   0x07    ; 7
        retlw   0x7F    ; 8
        retlw   0x6F    ; 9
        retlw   0x77    ; A
        retlw   0x7C    ; b
        retlw   0x39    ; C
        retlw   0x5E    ; d
        retlw   0x79    ; E
        retlw   0x71    ; F

;----------------------------------------------------
; Delay Function
;----------------------------------------------------
Delay:
        movlw   0xFF
        movwf   temp
Delay1:
        movlw   0xFF
        movwf   temp2
Delay2:
        decfsz  temp2, f
        goto    Delay2
        decfsz  temp, f
        goto    Delay1
        return

        end     resetVec
