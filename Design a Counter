;----------------------------------------------------
; Title: Hex Counter with 7-Segment Display
;----------------------------------------------------
; Purpose: This program uses two push buttons to control a hexadecimal counter displayed on a 7-segment display. One button increments the count, the other decrements it, and pressing both resets the count to zero.
; Dependencies: xc.inc
; Compiler: MPLAB X IDE v6.30 (XC8 Assembler)
; Author: Tyler Klahr
; Inputs: RB6 - Switch A (Increment), RB7 - Switch B (Decrement)
; Outputs: RD0–RD6 - 7-segment display (segments A–G)
; Versions: 
;     v1.0: 4/1/26 - Initial version
;----------------------------------------------------
       PROCESSOR   18F47K42
       #include    <xc.inc>

;----------------------------------------------------
; Configuration Bits
;----------------------------------------------------
CONFIG FEXTOSC = OFF
CONFIG RSTOSC = HFINTOSC_1MHZ
CONFIG CLKOUTEN = OFF
CONFIG PR1WAY = ON
CONFIG CSWEN = ON
CONFIG FCMEN = OFF

;----------------------------------------------------
; Variables
;----------------------------------------------------
PSECT udata_acs
count: DS 1
temp: DS 1
temp2: DS 1

;----------------------------------------------------
; Reset Vector
;----------------------------------------------------
PSECT resetVec,class=CODE,reloc=2
resetVec:
goto Start

;----------------------------------------------------
; Main Program
;----------------------------------------------------
PSECT code

Start:
banksel ANSELB
clrf ANSELB
clrf ANSELD

        banksel TRISB
        movlw   b'11000000'
        movwf   TRISB

        banksel TRISD
        clrf    TRISD

        banksel LATD
        clrf    LATD

        movlw   0x00
        movwf   count

;----------------------------------------------------
MainLoop:
call DisplayCount

        banksel PORTB
        btfss   PORTB, 6
        goto    CheckBOnly
        btfss   PORTB, 7
        goto    CheckAOnly
        goto    ResetCount
;----------------------------------------------------
CheckAOnly:
btfss PORTB, 6
goto CheckBOnly

        movlw   0x0F
        cpfseq  count
        goto    IncCount
        goto    HoldLoop

IncCount:
incf count, f
call Delay
goto MainLoop

;----------------------------------------------------
CheckBOnly:
btfss PORTB, 7
goto HoldLoop

        movf    count, w
        bz      HoldLoop
        decf    count, f
        call    Delay
        goto    MainLoop

;----------------------------------------------------
ResetCount:
clrf count
call Delay
goto MainLoop

;----------------------------------------------------
HoldLoop:
goto MainLoop
